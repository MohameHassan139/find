<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flImageRoot"
    android:layout_width="76dp"
    android:layout_height="76dp"
    android:layout_marginEnd="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="true">

    <!-- Image Container with Rounded Corners -->
    <FrameLayout
        android:id="@+id/flImageContainer"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="bottom|start"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp">

        <ImageView
            android:id="@+id/ivGalleryImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_image_placeholder"
            android:clipToOutline="true"
            android:contentDescription="@null" />

        <!-- Cover Border Outline -->
        <View
            android:id="@+id/vCoverBorder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_cover_image_border"
            android:visibility="gone" />

        <!-- Cover Badge "الغلاف" -->
        <TextView
            android:id="@+id/tvCoverBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_cover_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1.5dp"
            android:text="@string/cover_badge"
            android:textColor="@color/cover_badge_text"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Red Delete Button (X) placed at top-end -->
    <ImageView
        android:id="@+id/btnRemoveImage"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:src="@drawable/ic_remove_image"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/action_delete" />

</FrameLayout>
