<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen"
    android:layoutDirection="locale">

    <!-- Top Bar -->
    <include
        android:id="@+id/appBarBack"
        layout="@layout/layout_appbar_back" />

    <View 
        android:id="@+id/vTopBarShadow"
        android:layout_width="match_parent" 
        android:layout_height="1dp" 
        android:background="@color/shadow_divider" />

    <!-- Reusable home header: search + category tabs -->
    <include
        android:id="@+id/homeHeader"
        layout="@layout/layout_home_header" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_surface_tabs_rounded"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_create_account"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <!-- ── STEP 1: Phone ── -->
            <LinearLayout
                android:id="@+id/layoutPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="16dp">

                <TextView
                    android:id="@+id/labelPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_phone"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_gravity="start"
                    android:layout_marginBottom="8dp"
                    android:drawableStart="@drawable/ic_phone"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/text_secondary" />

                <!-- Phone input row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:layoutDirection="ltr">

                    <!-- Country code -->
                    <EditText
                        android:id="@+id/etCountryCode"
                        android:layout_width="72dp"
                        android:layout_height="match_parent"
                        android:text="@string/str_966"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_rounded_input"
                        android:inputType="phone"
                        android:maxLength="5" />

                    <!-- Number field -->
                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_input"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:gravity="start|center_vertical"
                        android:hint="@string/str_5xxxxxxxx"
                        android:textSize="16sp"
                        android:paddingHorizontal="12dp"
                        android:inputType="phone"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Send OTP button -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/btnSendOtp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="180dp"
                        android:paddingHorizontal="24dp"
                        android:background="@drawable/bg_rounded_input"
                        android:text="@string/send_otp"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground" />

                    <ProgressBar
                        android:id="@+id/progressPhone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- ── STEP 2: OTP ── -->
            <LinearLayout
                android:id="@+id/layoutOtp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvOtpHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/send_otp_to"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="12dp" />

                <!-- OTP input -->
                <EditText
                    android:id="@+id/etOtp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_rounded_input"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:gravity="center"
                    android:hint="• • • • • •"
                    android:textSize="22sp"
                    android:inputType="numberPassword"
                    android:maxLength="6"
                    android:letterSpacing="0.5" />

                <!-- Resend timer -->
                <TextView
                    android:id="@+id/tvResend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/resend_after_60s"
                    android:textSize="13sp"
                    android:textColor="@color/find_primary"
                    android:layout_gravity="center_horizontal"
                    android:padding="8dp"
                    android:layout_marginTop="8dp" />

                <!-- Verify button -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/btnVerifyOtp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="180dp"
                        android:paddingHorizontal="24dp"
                        android:background="@drawable/bg_rounded_input"
                        android:text="@string/verify"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground" />

                    <ProgressBar
                        android:id="@+id/progressOtp"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Change phone -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/btnChangePhone"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="180dp"
                        android:paddingHorizontal="24dp"
                        android:background="@drawable/bg_rounded_input"
                        android:text="@string/change_number"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground" />
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Nav -->
    <include
        android:id="@+id/cvBottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp" />

</LinearLayout>
