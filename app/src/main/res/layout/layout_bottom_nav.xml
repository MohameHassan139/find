<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvBottomNav"
    android:layout_width="match_parent"
    android:layout_height="65dp"
    app:cardCornerRadius="32.5dp"
    app:cardElevation="@dimen/bottom_nav_elevation"
    app:cardBackgroundColor="@color/bottom_nav_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_nav_glass"
        android:orientation="horizontal"
        android:layoutDirection="locale"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <!-- الرئيسية -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginHorizontal="4dp"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivNavHome"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_nav_home"
                android:scaleType="fitCenter"
                android:contentDescription="الرئيسية" />

            <TextView
                android:id="@+id/tvNavHome"
                style="@style/Find.Text.TabBarLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_home"
                android:textColor="@color/nav_text_unselected" />
        </LinearLayout>

        <!-- أضف إعلان -->
        <LinearLayout
            android:id="@+id/navAdd"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginHorizontal="4dp"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivNavAdd"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_nav_add"
                android:scaleType="fitCenter"
                android:contentDescription="أضف إعلان" />

            <TextView
                android:id="@+id/tvNavAdd"
                style="@style/Find.Text.TabBarLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_add_ad"
                android:textColor="@color/nav_text_unselected" />
        </LinearLayout>

        <!-- المحادثات -->
        <LinearLayout
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginHorizontal="4dp"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivNavChat"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_nav_chat"
                android:scaleType="fitCenter"
                android:contentDescription="المحادثات" />

            <TextView
                android:id="@+id/tvNavChat"
                style="@style/Find.Text.TabBarLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_chats"
                android:textColor="@color/nav_text_unselected" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
