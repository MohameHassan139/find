<?xml version="1.0" encoding="utf-8"?>
<!-- Logo container matching Figma CSS:
     width: 104px, height: 54px; Vector (stroke 2px, mirrored); فايندز (Baloo Bhaijaan 20px, 400); finds (SF Pro Rounded 24px, 700) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llAppLogo"
    android:layout_width="wrap_content"
    android:layout_height="54dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layoutDirection="ltr">

    <!-- Vector: Snowflake emblem (flipped horizontally scaleX=-1, stroke 2px, white in dark / black in light) -->
    <ImageView
        android:id="@+id/ivLogoSnowflake"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_app_logo"
        app:tint="@color/appbar_logo_text"
        android:contentDescription="Finds"
        android:layout_marginEnd="6dp" />

    <!-- Text stack: فايندز (top, Baloo Bhaijaan) and finds (bottom, SF Pro Rounded bold) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- فايندز: Baloo Bhaijaan style, weight 400, 20px (#FFFFFF in dark, #000000 in light) -->
        <TextView
            android:id="@+id/tvLogoAr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="فايندز"
            android:textSize="17sp"
            android:fontFamily="sans-serif"
            android:textStyle="normal"
            android:textColor="@color/appbar_logo_text"
            android:includeFontPadding="false" />

        <!-- finds: SF Pro Rounded, weight 700, 24px (#FFFFFF in dark, #000000 in light) -->
        <TextView
            android:id="@+id/tvLogoEn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="finds"
            android:textSize="20sp"
            android:fontFamily="sans-serif-rounded"
            android:textStyle="bold"
            android:textColor="@color/appbar_logo_text"
            android:includeFontPadding="false"
            android:layout_marginTop="-4dp" />
    </LinearLayout>
</LinearLayout>
