<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="@color/surface_primary"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:orientation="horizontal"
        android:layoutDirection="locale">

        <!-- Info side -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="6dp"
            android:paddingTop="14dp"
            android:paddingBottom="11dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="16dp"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end"
                android:gravity="start"
                android:textAlignment="viewStart" />

            <!-- Spacer 1 (flexible weight) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Row 2: seller avatar + name (right) and Riyal symbol + price (left) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Seller Group -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_avatar_placeholder"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_avatar_circle" />

                    <TextView
                        android:id="@+id/tvSeller"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textSize="10sp"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <!-- Price Group -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvRiyalSymbol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" ﷼"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginEnd="3dp" />

                    <TextView
                        android:id="@+id/tvPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Spacer 2 (fixed spacing) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="11dp" />

            <!-- Row 3: location (right) and time (left) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Location Group -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/text_primary"
                        android:layout_marginEnd="4dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <!-- Time Group -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_time"
                        app:tint="@color/text_primary"
                        android:layout_marginEnd="4dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Image side (147dp width, matches Figma 147px) -->
        <FrameLayout
            android:layout_width="147dp"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_photo_placeholder"
                android:importantForAccessibility="no" />

            <!-- Left arrow -->
            <ImageView
                android:id="@+id/ivPrevImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="2dp"
                android:padding="1dp"
                android:src="@drawable/ic_card_chevron_left"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                android:contentDescription="Previous image" />

            <!-- Right arrow -->
            <ImageView
                android:id="@+id/ivNextImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="3dp"
                android:layout_marginBottom="2dp"
                android:padding="1dp"
                android:src="@drawable/ic_card_chevron_right"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                android:contentDescription="Next image" />

            <!-- Favorite bookmark top-end -->
            <ImageView
                android:id="@+id/ivFavorite"
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="7dp"
                android:layout_marginTop="7dp"
                android:src="@drawable/ic_favorite_bookmark"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Favorite" />

            <!-- Hidden Type badge (kept for binding compatibility) -->
            <TextView
                android:id="@+id/tvType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
