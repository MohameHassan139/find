<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:clipToOutline="true"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="@color/surface_primary"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="130dp"
        android:orientation="horizontal"
        android:layoutDirection="locale">

        <!-- Info side -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="130dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:lines="4"
                android:minLines="4"
                android:maxLines="4"
                android:ellipsize="end"
                android:gravity="top|start"
                android:textAlignment="viewStart"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="0.80"
                android:lineSpacingExtra="-2dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Row 1: Location -->
            <LinearLayout
                android:id="@+id/llRowLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                app:layout_constraintBottom_toTopOf="@+id/llRowBottom"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_bias="1.0">

                <!-- Location Group -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivLocationIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_map_pin"
                        app:tint="@color/text_primary"
                        android:layout_marginEnd="4dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tvLocation"
                        style="@style/Find.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Time (start) and Price (end) down with text -->
            <LinearLayout
                android:id="@+id/llRowBottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@+id/llRowLocation"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Time Group -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivTimeIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_time"
                        app:tint="@color/text_primary"
                        android:layout_marginEnd="4dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tvTime"
                        style="@style/Find.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <!-- Price Group (down with text, SAR icon on other side) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivRiyalSymbol"
                        android:layout_width="18dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_currency_sar"
                        app:tint="@color/text_primary"
                        android:layout_marginEnd="3dp" />

                    <TextView
                        android:id="@+id/tvPrice"
                        style="@style/Find.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hidden seller views (removed from outside card) -->
            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvSeller"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Image side (147dp width, matches Figma 147px) -->
        <FrameLayout
            android:id="@+id/flCardImage"
            android:layout_width="147dp"
            android:layout_height="match_parent">

            <!-- Swipeable gallery (same behaviour as the ad details screen) -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpCardImages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layoutDirection="ltr"
                android:visibility="gone" />

            <!-- Shown when the ad has no images -->
            <ImageView
                android:id="@+id/ivImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:background="@color/placeholder_bg"
                android:src="@drawable/ic_photo_placeholder"
                android:importantForAccessibility="no" />

            <!-- Dots indicator, over the image (as on the ad details screen) -->
            <LinearLayout
                android:id="@+id/llCardDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_dots_indicator_pill"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:visibility="gone" />

            <!-- Previous arrow — start edge, vertically centred, 6dp inset
                 (iOS: HStack { prev; Spacer(); next }.padding(.horizontal, 6)).
                 Must be start/end, not left/right: the chevrons are
                 autoMirrored, so in RTL the glyphs flip and the positions
                 have to flip with them. -->
            <ImageView
                android:id="@+id/ivPrevImage"
                style="@style/Widget.Find.CarouselArrow"
                android:layout_gravity="bottom|start"
                android:src="@drawable/ic_card_chevron_left"
                android:visibility="gone"
                android:contentDescription="@string/cd_previous_image" />

            <!-- Next arrow — end edge. -->
            <ImageView
                android:id="@+id/ivNextImage"
                style="@style/Widget.Find.CarouselArrow"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_card_chevron_right"
                android:visibility="gone"
                android:contentDescription="@string/cd_next_image" />

            <!-- Favorite bookmark top-end -->
            <ImageView
                android:id="@+id/ivFavorite"
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_favorite_pill"
                android:src="@drawable/ic_favorite_bookmark"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Favorite" />

            <!-- Hidden Type badge (kept for binding compatibility) -->
            <TextView
                android:id="@+id/tvType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
