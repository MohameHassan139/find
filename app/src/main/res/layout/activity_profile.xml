<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen"
    android:layoutDirection="locale">

    <!-- Top Bar -->
    <include layout="@layout/layout_appbar_back" />

    <!-- Reusable home header: search + category tabs -->
    <include layout="@layout/layout_home_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:layoutDirection="locale">

            <!-- Nafath Verification Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardNafath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/nafath_bg"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:layoutDirection="locale">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="50dp"
                        android:src="@drawable/ic_nafath"
                        android:scaleType="fitCenter"
                        android:contentDescription="Nafath" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_verify_nafath"
                        android:textColor="#004D40"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:textSize="14sp"
                        android:gravity="center" />

                    <Button
                        android:id="@+id/btnVerifyNafath"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_verify_nafath_btn"
                        android:backgroundTint="@color/nafath_button"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:paddingHorizontal="20dp"
                        style="@style/Widget.MaterialComponents.Button" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Profile Image Container -->
            <FrameLayout
                android:id="@+id/profileContainer"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_profile_image_rect"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toBottomOf="@id/cardNafath"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Outer Card to force crop of avatar image to a perfect circle -->
                <androidx.cardview.widget.CardView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_user_placeholder"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_edit_pen"
                    android:background="@drawable/bg_menu_circle"
                    android:backgroundTint="@color/toggle_active_green"
                    android:padding="6dp"
                    android:contentDescription="Edit" />
            </FrameLayout>

            <!-- Name Label -->
            <TextView
                android:id="@+id/labelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/profile_name"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:drawableStart="@drawable/ic_name"
                android:drawablePadding="8dp"
                app:layout_constraintTop_toBottomOf="@id/profileContainer"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Name Input Field -->
            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_rounded_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="start|center_vertical"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:hint="@string/str_____"
                android:layoutDirection="locale"
                android:textDirection="locale"
                app:layout_constraintTop_toBottomOf="@id/labelName" />

            <!-- Phone Label -->
            <TextView
                android:id="@+id/labelPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/profile_phone"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:drawableStart="@drawable/ic_phone"
                android:drawablePadding="8dp"
                app:layout_constraintTop_toBottomOf="@id/etName"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Phone Display Field -->
            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_rounded_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="start|center_vertical"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layoutDirection="locale"
                android:textDirection="locale"
                app:layout_constraintTop_toBottomOf="@id/labelPhone" />

            <!-- Save Button Wrapper Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_primary"
                app:layout_constraintTop_toBottomOf="@id/tvPhone">

                <TextView
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/save_changes"
                    android:textSize="16sp"
                    android:textColor="@color/find_active_blue"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </androidx.cardview.widget.CardView>

            <!-- Sign Out Button Wrapper Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSignOut"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_primary"
                app:layout_constraintTop_toBottomOf="@id/cardSave"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/btnSignOut"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/logout"
                    android:textSize="15sp"
                    android:textColor="@color/error_red"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Bottom Nav -->
    <include
        android:id="@+id/cvBottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp" />

</LinearLayout>
