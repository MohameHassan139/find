<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen"
    android:layoutDirection="locale">

    <!-- Top Bar -->
    <include layout="@layout/layout_appbar_back" />

    <!-- Reusable home header: search + category tabs -->
    <include layout="@layout/layout_home_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:layoutDirection="locale">

            <!-- Nafath Verification Banner -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardNafath"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivNafathBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_nafath"
                    android:scaleType="fitXY"
                    android:contentDescription="Nafath" />
            </androidx.cardview.widget.CardView>

            <!-- Profile Image Container (iOS Parity: 120dp x 103dp, 16dp rounded box, 18% yellow fill) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/profileContainer"
                android:layout_width="120dp"
                android:layout_height="103dp"
                android:layout_marginTop="28dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#2EF5C518"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toBottomOf="@id/cardNafath"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_person_avatar"
                        android:scaleType="centerCrop"
                        app:tint="@color/text_primary" />

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"
                        android:src="@drawable/ic_pen_edit"
                        app:tint="@color/text_primary"
                        android:contentDescription="Edit" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Name Label -->
            <TextView
                android:id="@+id/labelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/profile_name"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:drawableStart="@drawable/ic_person_id_card"
                android:drawablePadding="8dp"
                app:drawableTint="@color/text_primary"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/profileContainer"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Name Input Field -->
            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_rounded_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="start|center_vertical"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:hint="@string/str_____"
                android:layoutDirection="locale"
                android:textDirection="locale"
                app:layout_constraintTop_toBottomOf="@id/labelName" />

            <!-- Phone Label -->
            <TextView
                android:id="@+id/labelPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/profile_phone"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:drawableStart="@drawable/ic_phone"
                android:drawablePadding="8dp"
                app:drawableTint="@color/text_primary"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/etName"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Phone Display Field -->
            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_rounded_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="start|center_vertical"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layoutDirection="ltr"
                android:textDirection="ltr"
                app:layout_constraintTop_toBottomOf="@id/labelPhone" />

            <!-- Save Button (Yellow primary button #F5C518) -->
            <TextView
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_btn_publish"
                android:text="@string/save_changes"
                android:textSize="17sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toBottomOf="@id/tvPhone" />

            <!-- Sign Out Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSignOut"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_primary"
                app:layout_constraintTop_toBottomOf="@id/btnSave"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/btnSignOut"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/logout"
                    android:textSize="16sp"
                    android:textColor="@color/error_red"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Bottom Nav -->
    <include
        android:id="@+id/cvBottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp" />

</LinearLayout>
