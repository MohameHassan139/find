<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="3dp">

    <!-- MY message (Sent) — sticks to LEFT in AR (RTL) and RIGHT in EN (LTR) -->
    <LinearLayout
        android:id="@+id/layoutSent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_bubble_sent"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:layoutDirection="locale"
        android:visibility="gone">

        <!-- Message text -->
        <TextView
            android:id="@+id/tvMessageSent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/bubble_text_sent"
            android:lineSpacingExtra="3dp"
            android:maxWidth="220dp"
            android:layout_marginEnd="8dp"
            android:textAlignment="viewStart" />

        <!-- Time + Checkmarks -->
        <LinearLayout
            android:id="@+id/layoutTimeSent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="locale">

            <TextView
                android:id="@+id/tvTimeSent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/bubble_time_sent"
                android:layout_marginEnd="3dp" />

            <ImageView
                android:id="@+id/ivReadStatus"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_double_check" />
        </LinearLayout>

    </LinearLayout>

    <!-- OTHER message (Received) — sticks to RIGHT in AR (RTL) and LEFT in EN (LTR) -->
    <LinearLayout
        android:id="@+id/layoutReceived"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bg_bubble_received"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:layoutDirection="locale"
        android:visibility="gone">

        <!-- Message text -->
        <TextView
            android:id="@+id/tvMessageReceived"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/bubble_text_received"
            android:lineSpacingExtra="3dp"
            android:maxWidth="220dp"
            android:layout_marginEnd="8dp"
            android:textAlignment="viewStart" />

        <!-- Time -->
        <TextView
            android:id="@+id/tvTimeReceived"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/bubble_time_received" />

    </LinearLayout>

</FrameLayout>
