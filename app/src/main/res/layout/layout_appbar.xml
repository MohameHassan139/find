<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llAppBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_appbar"
    android:elevation="@dimen/header_elevation"
    android:layoutDirection="locale">

    <!-- Status bar spacer -->
    <View
        android:id="@+id/statusBarSpacer"
        android:layout_width="match_parent"
        android:layout_height="28dp" />

    <!-- Actual bar content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="0dp">

        <!-- Menu button — left edge -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_menu_circle"
            android:padding="10dp"
            android:src="@drawable/ic_menu_black"
            app:tint="@color/appbar_icon_tint"
            android:contentDescription="القائمة" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Logo container matching Figma CSS:
             width: 104px, height: 54px; Vector (stroke 2px, mirrored); فايندز (20px, 400); finds (SF Pro Rounded 24px, 700) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="ltr">

            <!-- Vector: Snowflake emblem (flipped horizontally scaleX=-1, stroke 2px, white in dark / black in light) -->
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_app_logo"
                app:tint="@color/appbar_logo_text"
                android:contentDescription="Finds"
                android:layout_marginEnd="6dp" />

            <!-- Text stack: فايندز (top) and finds (bottom) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- فايندز: weight 400, 20px (#FFFFFF in dark, #000000 in light) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="فايندز"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:textColor="@color/appbar_logo_text"
                    android:includeFontPadding="false" />

                <!-- finds: SF Pro Rounded / sans-serif-rounded, weight 700, 24px (#FFFFFF in dark, #000000 in light) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="finds"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold"
                    android:textColor="@color/appbar_logo_text"
                    android:includeFontPadding="false"
                    android:layout_marginTop="-4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
