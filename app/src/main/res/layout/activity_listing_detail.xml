<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/find_gray_bg"
    android:layoutDirection="locale">

    <!-- ── Sticky Header (logo + menu + search + category tabs) ── -->
    <LinearLayout
        android:id="@+id/llStickyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_primary"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- App bar: logo (right) + menu + back (left) -->
        <LinearLayout
            android:id="@+id/llAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface_primary"
            android:layoutDirection="ltr">

            <!-- Status bar spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="28dp" />

            <!-- Bar content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

            <!-- Back button -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_menu_circle"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/cd_back" />

            <!-- Menu button -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_menu_circle"
                android:padding="10dp"
                android:src="@drawable/ic_menu_black"
                android:contentDescription="@string/cd_menu" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Logo -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name_ar"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="-2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name_en"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="-2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_app_logo"
                    android:contentDescription="Find"
                    android:padding="2dp" />
            </LinearLayout>
            </LinearLayout><!-- end bar content -->
        </LinearLayout><!-- end llAppBar -->

        <!-- Search bar -->
        <LinearLayout
            android:id="@+id/llHomeSearchContainer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:alpha="0.5"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvSearchHint"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="8dp"
                android:textSize="14sp"
                android:text="@string/search_anything"
                android:textColor="@color/find_gray_text" />
        </LinearLayout>

        <!-- Category tabs (reuse HomeHeaderHelper's RecyclerView ids) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHomeTopTabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/surface_tabs"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Shimmer placeholder -->
        <LinearLayout
            android:id="@+id/llHomeTabShimmer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="@color/surface_tabs">

            <View android:layout_width="80dp" android:layout_height="32dp"
                android:layout_marginEnd="8dp" android:background="@drawable/bg_category_shimmer" />
            <View android:layout_width="100dp" android:layout_height="32dp"
                android:layout_marginEnd="8dp" android:background="@drawable/bg_category_shimmer" />
            <View android:layout_width="120dp" android:layout_height="32dp"
                android:layout_marginEnd="8dp" android:background="@drawable/bg_category_shimmer" />
            <View android:layout_width="70dp" android:layout_height="32dp"
                android:background="@drawable/bg_category_shimmer" />
        </LinearLayout>

    </LinearLayout>

    <!-- ── Scrollable content ── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/llStickyHeader"
        app:layout_constraintBottom_toTopOf="@id/cvBottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Top shadow for CardView -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_top_shadow" />

            <!-- Main card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="0dp"
                android:clipToOutline="true"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Card.TopRounded"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/surface_primary"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Shaded Top Section -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clShadedHeader"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:background="@color/ad_details_header_bg">

                        <!-- Title -->
                        <TextView
                            android:id="@+id/tvTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:layout_marginTop="16dp"
                            android:textAlignment="viewStart"
                            android:textColor="@color/text_primary"
                            android:textSize="19sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Avatar (Seller logo, size 24x24, top 82dp, left 186.5dp) -->
                        <ImageView
                            android:id="@+id/ivAvatar"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_avatar_placeholder"
                            android:scaleType="centerCrop"
                            android:background="@drawable/bg_menu_circle"
                            android:padding="1dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            android:layout_marginTop="82dp"
                            android:layout_marginStart="186.5dp" />

                        <!-- Seller Name (To the end/left of Avatar in RTL, 10sp, Regular) -->
                        <TextView
                            android:id="@+id/tvSellerName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textAlignment="viewStart"
                            app:layout_constraintTop_toTopOf="@id/ivAvatar"
                            app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
                            app:layout_constraintStart_toEndOf="@id/ivAvatar"
                            app:layout_constraintEnd_toStartOf="@id/tvRiyalSymbol" />

                        <!-- Price (Left side in RTL, 10sp, Regular) -->
                        <TextView
                            android:id="@+id/tvPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textColor="@color/text_primary"
                            app:layout_constraintTop_toTopOf="@id/ivAvatar"
                            app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginEnd="16dp" />

                        <!-- Riyal Symbol (To the start/right of Price in RTL, 10sp, Regular) -->
                        <TextView
                            android:id="@+id/tvRiyalSymbol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" ﷼"
                            android:textSize="10sp"
                            android:textColor="@color/text_primary"
                            app:layout_constraintTop_toTopOf="@id/tvPrice"
                            app:layout_constraintBottom_toBottomOf="@id/tvPrice"
                            app:layout_constraintEnd_toStartOf="@id/tvPrice"
                            android:layout_marginEnd="2dp" />

                        <!-- Location Icon (Centered under Avatar, top 118dp) -->
                        <ImageView
                            android:id="@+id/ivLocationIcon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_location"
                            app:tint="@color/find_gray_text"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="@id/ivAvatar"
                            app:layout_constraintEnd_toEndOf="@id/ivAvatar"
                            android:layout_marginTop="118dp" />

                        <!-- Location Text (To the end/left of Pin Icon in RTL, 10sp, Regular) -->
                        <TextView
                            android:id="@+id/tvLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/find_gray_text"
                            android:textSize="10sp"
                            android:textAlignment="viewStart"
                            app:layout_constraintTop_toTopOf="@id/ivLocationIcon"
                            app:layout_constraintBottom_toBottomOf="@id/ivLocationIcon"
                            app:layout_constraintStart_toEndOf="@id/ivLocationIcon"
                            app:layout_constraintEnd_toStartOf="@id/ivTimeIcon" />

                        <!-- Time Text (Left side in RTL, 10sp, Regular) -->
                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textColor="@color/find_gray_text"
                            app:layout_constraintTop_toTopOf="@id/ivLocationIcon"
                            app:layout_constraintBottom_toBottomOf="@id/ivLocationIcon"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginEnd="16dp" />

                        <!-- Clock Icon (To the start/right of Time in RTL) -->
                        <ImageView
                            android:id="@+id/ivTimeIcon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_time"
                            app:tint="@color/find_gray_text"
                            app:layout_constraintTop_toTopOf="@id/tvTime"
                            app:layout_constraintBottom_toBottomOf="@id/tvTime"
                            app:layout_constraintEnd_toStartOf="@id/tvTime"
                            android:layout_marginEnd="4dp" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" />

                    <!-- Action bar: Call / WhatsApp / Chat (Right) | Chevrons (Left) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:orientation="horizontal"
                        android:background="@color/surface_primary"
                        android:gravity="center_vertical"
                        android:layoutDirection="locale">

                        <!-- Call / WhatsApp / Chat buttons container (RIGHT side in RTL) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <!-- إتصال -->
                            <LinearLayout
                                android:id="@+id/btnCall"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="?attr/selectableItemBackground">

                                <ImageView
                                    android:id="@+id/ivCall"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_phone"
                                    android:contentDescription="@string/cd_call"
                                    app:tint="@color/text_primary" />

                                <TextView
                                    android:id="@+id/tvCall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/btn_call"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>

                            <!-- واتساب -->
                            <LinearLayout
                                android:id="@+id/btnWhatsapp"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="?attr/selectableItemBackground">

                                <ImageView
                                    android:id="@+id/ivWhatsapp"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_whatsapp"
                                    android:contentDescription="@string/cd_whatsapp" />

                                <TextView
                                    android:id="@+id/tvWhatsapp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/btn_whatsapp"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>

                            <!-- محادثة -->
                            <LinearLayout
                                android:id="@+id/btnChat"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="?attr/selectableItemBackground">

                                <ImageView
                                    android:id="@+id/ivChat"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:contentDescription="@string/cd_chat"
                                    android:src="@drawable/ic_nav_chat"
                                    app:tint="@color/text_primary" />

                                <TextView
                                    android:id="@+id/tvChat"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/btn_chat"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Main vertical divider (bold) -->
                        <View android:layout_width="1dp" android:layout_height="match_parent"
                            android:background="@color/divider" />

                        <!-- Chevrons container (LEFT side in RTL, width 120dp, forced LTR) -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="120dp"
                            android:layout_height="match_parent"
                            android:background="@color/surface_primary"
                            android:layoutDirection="ltr">

                            <!-- Prev button (left chevron) -->
                            <ImageButton
                                android:id="@+id/btnPrev"
                                android:layout_width="20dp"
                                android:layout_height="35dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_figma_chevron_left"
                                app:tint="@color/ad_details_chevron_tint"
                                android:scaleType="fitCenter"
                                android:padding="0dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                android:layout_marginStart="9dp"
                                android:contentDescription="Previous" />

                            <!-- Next button (right chevron) -->
                            <ImageButton
                                android:id="@+id/btnNext"
                                android:layout_width="20dp"
                                android:layout_height="35dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_figma_chevron_right"
                                app:tint="@color/ad_details_chevron_tint"
                                android:scaleType="fitCenter"
                                android:padding="0dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                android:layout_marginStart="72dp"
                                android:contentDescription="Next" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- Hidden favorite view to keep compatibility with Kotlin logic -->
                        <ImageView
                            android:id="@+id/ivFavoriteDetail"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone"
                            android:importantForAccessibility="no" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Description -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.6"
                android:textAlignment="viewStart" />

            <!-- Images (full width, below card) -->
            <LinearLayout
                android:id="@+id/llImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Bottom Nav ── -->
    <include
        android:id="@+id/cvBottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
