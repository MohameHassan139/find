<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ad_details_screen_bg"
    android:layoutDirection="locale">

    <!-- ── Sticky Header (logo + menu + search + category tabs) ── -->
    <LinearLayout
        android:id="@+id/llStickyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/header_bg"
        android:elevation="@dimen/header_elevation"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- App bar: logo (right) + menu + back (left) -->
        <LinearLayout
            android:id="@+id/llAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_appbar"
            android:layoutDirection="locale">

            <!-- Status bar spacer -->
            <View
                android:id="@+id/statusBarSpacer"
                android:layout_width="match_parent"
                android:layout_height="36dp" />

            <!-- Bar content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="0dp">

            <!-- Back button -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back_nav"
                app:tint="@color/appbar_icon_tint"
                android:contentDescription="@string/cd_back" />

            <!-- Menu button -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_menu_circle"
                android:padding="10dp"
                android:src="@drawable/ic_menu_black"
                app:tint="@color/appbar_icon_tint"
                android:contentDescription="@string/cd_menu" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Logo -->
            <ImageView
                android:id="@+id/ivAppLogo"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_app_logo_lockup"
                android:contentDescription="Finds" />
            </LinearLayout><!-- end bar content -->
        </LinearLayout><!-- end llAppBar -->

        <!-- Search bar -->
        <LinearLayout
            android:id="@+id/llHomeSearchContainer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layoutDirection="locale"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvSearchHint"
                style="@style/Find.Text.SearchPlaceholder"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layoutDirection="locale"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="8dp"
                android:text="@string/search_hint"
                android:textColor="@color/search_hint_text" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_search"
                app:tint="@color/search_icon_tint"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Category tabs (reuse HomeHeaderHelper's RecyclerView ids) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHomeTopTabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_tab_row"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Shimmer placeholder -->
        <LinearLayout
            android:id="@+id/llHomeTabShimmer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="@color/tab_bar_bg">

            <View android:layout_width="80dp" android:layout_height="32dp"
                android:layout_marginEnd="8dp" android:background="@drawable/bg_category_shimmer" />
            <View android:layout_width="100dp" android:layout_height="32dp"
                android:layout_marginEnd="8dp" android:background="@drawable/bg_category_shimmer" />
            <View android:layout_width="120dp" android:layout_height="32dp"
                android:layout_marginEnd="8dp" android:background="@drawable/bg_category_shimmer" />
            <View android:layout_width="70dp" android:layout_height="32dp"
                android:background="@drawable/bg_category_shimmer" />
        </LinearLayout>

    </LinearLayout>

    <!-- ── Scrollable content ── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="100dp"
        android:background="@color/ad_details_screen_bg"
        app:layout_constraintTop_toBottomOf="@id/llStickyHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Main card (Figma Frame: left 6px, border-radius 5px, box-shadow).
                 match_parent + fillViewport: on short ads (e.g. no photos) the card
                 still reaches the bottom instead of ending mid-screen. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="10dp"
                android:clipToOutline="true"
                app:cardCornerRadius="5dp"
                app:cardElevation="@dimen/ad_details_card_elevation"
                app:cardBackgroundColor="@color/ad_details_card_bg"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Shaded Top Section -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clShadedHeader"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:background="@color/frame_43_bg">

                        <!-- Title -->
                        <TextView
                            android:id="@+id/tvTitle"
                            style="@style/Find.Text.AdTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="16dp"
                            android:textAlignment="viewStart"
                            android:textColor="@color/text_primary"
                            android:maxLines="2"
                            android:ellipsize="end"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Avatar (Seller logo, size 24x24, top 82dp, left 186.5dp) -->
                        <ImageView
                            android:id="@+id/ivAvatar"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_avatar_placeholder"
                            android:scaleType="centerCrop"
                            android:background="@drawable/bg_menu_circle"
                            android:padding="1dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            android:layout_marginTop="82dp"
                            android:layout_marginStart="186.5dp" />

                        <!-- Seller Name (To the end/left of Avatar in RTL, 10sp, Regular) -->
                        <TextView
                            android:id="@+id/tvSellerName"
                            style="@style/Find.Text.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textAlignment="viewStart"
                            app:layout_constraintTop_toTopOf="@id/ivAvatar"
                            app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
                            app:layout_constraintStart_toEndOf="@id/ivAvatar"
                            app:layout_constraintEnd_toStartOf="@id/ivRiyalSymbol" />

                        <!-- Price (Left side in RTL, 10sp, Regular) -->
                        <TextView
                            android:id="@+id/tvPrice"
                            style="@style/Find.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            app:layout_constraintTop_toTopOf="@id/ivAvatar"
                            app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginEnd="16dp" />

                        <!-- Riyal Symbol (To the start/right of Price in RTL, 10sp, Regular) -->
                        <ImageView
                            android:id="@+id/ivRiyalSymbol"
                            android:layout_width="11dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_currency_sar"
                            app:tint="@color/text_primary"
                            app:layout_constraintTop_toTopOf="@id/tvPrice"
                            app:layout_constraintBottom_toBottomOf="@id/tvPrice"
                            app:layout_constraintEnd_toStartOf="@id/tvPrice"
                            android:layout_marginEnd="2dp" />

                        <!-- Location Icon (Centered under Avatar, top 118dp) -->
                        <ImageView
                            android:id="@+id/ivLocationIcon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_location"
                            app:tint="@color/find_gray_text"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="@id/ivAvatar"
                            app:layout_constraintEnd_toEndOf="@id/ivAvatar"
                            android:layout_marginTop="118dp" />

                        <!-- Location Text (To the end/left of Pin Icon in RTL, 10sp, Regular) -->
                        <TextView
                            android:id="@+id/tvLocation"
                            style="@style/Find.Text.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/find_gray_text"
                            android:textAlignment="viewStart"
                            app:layout_constraintTop_toTopOf="@id/ivLocationIcon"
                            app:layout_constraintBottom_toBottomOf="@id/ivLocationIcon"
                            app:layout_constraintStart_toEndOf="@id/ivLocationIcon"
                            app:layout_constraintEnd_toStartOf="@id/ivTimeIcon" />

                        <!-- Time Text (Left side in RTL, 10sp, Regular) -->
                        <TextView
                            android:id="@+id/tvTime"
                            style="@style/Find.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/find_gray_text"
                            app:layout_constraintTop_toTopOf="@id/ivLocationIcon"
                            app:layout_constraintBottom_toBottomOf="@id/ivLocationIcon"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginEnd="16dp" />

                        <!-- Clock Icon (To the start/right of Time in RTL) -->
                        <ImageView
                            android:id="@+id/ivTimeIcon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_time"
                            app:tint="@color/find_gray_text"
                            app:layout_constraintTop_toTopOf="@id/tvTime"
                            app:layout_constraintBottom_toBottomOf="@id/tvTime"
                            app:layout_constraintEnd_toStartOf="@id/tvTime"
                            android:layout_marginEnd="4dp" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" />

                    <!-- Action bar: Call / WhatsApp / Chat (Right) | Chevrons (Left) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:orientation="horizontal"
                        android:background="@color/ad_details_card_bg"
                        android:gravity="center_vertical"
                        android:layoutDirection="locale">

                        <!-- Call / WhatsApp / Chat buttons container (RIGHT side in RTL) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <!-- إتصال -->
                            <LinearLayout
                                android:id="@+id/btnCall"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="?attr/selectableItemBackground">

                                <ImageView
                                    android:id="@+id/ivCall"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_marginTop="5dp"
                                    android:src="@drawable/ic_channel_call"
                                    android:contentDescription="@string/cd_call"
                                    app:tint="@color/appbar_icon_tint" />

                                <TextView
                                    android:id="@+id/tvCall"
                                    style="@style/Find.Text.ActionLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/btn_call"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>

                            <!-- واتساب -->
                            <LinearLayout
                                android:id="@+id/btnWhatsapp"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="?attr/selectableItemBackground">

                                <ImageView
                                    android:id="@+id/ivWhatsapp"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_marginTop="5dp"
                                    android:src="@drawable/ic_channel_whatsapp"
                                    android:contentDescription="@string/cd_whatsapp"
                                    app:tint="@color/appbar_icon_tint" />

                                <TextView
                                    android:id="@+id/tvWhatsapp"
                                    style="@style/Find.Text.ActionLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/btn_whatsapp"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>

                            <!-- محادثة -->
                            <LinearLayout
                                android:id="@+id/btnChat"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="?attr/selectableItemBackground">

                                <ImageView
                                    android:id="@+id/ivChat"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_marginTop="5dp"
                                    android:contentDescription="@string/cd_chat"
                                    android:src="@drawable/ic_channel_chat"
                                    app:tint="@color/appbar_icon_tint" />

                                <TextView
                                    android:id="@+id/tvChat"
                                    style="@style/Find.Text.ActionLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/btn_chat"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Main vertical divider (bold) -->
                        <View android:layout_width="1dp" android:layout_height="match_parent"
                            android:background="@color/divider" />

                        <!-- Chevrons container (LEFT side in RTL, width 120dp, forced LTR) -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="120dp"
                            android:layout_height="match_parent"
                            android:background="@color/ad_details_card_bg"
                            android:layoutDirection="ltr">

                            <!-- Next button (left chevron in Arabic, advances to next ad) -->
                            <ImageButton
                                android:id="@+id/btnNext"
                                android:layout_width="20dp"
                                android:layout_height="35dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_figma_chevron_left"
                                app:tint="@color/ad_details_chevron_tint"
                                android:scaleType="fitCenter"
                                android:padding="0dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                android:layout_marginStart="9dp"
                                android:contentDescription="Next" />

                            <!-- Prev button (right chevron in Arabic, returns to previous ad) -->
                            <ImageButton
                                android:id="@+id/btnPrev"
                                android:layout_width="20dp"
                                android:layout_height="35dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_figma_chevron_right"
                                app:tint="@color/ad_details_chevron_tint"
                                android:scaleType="fitCenter"
                                android:padding="0dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                android:layout_marginStart="72dp"
                                android:contentDescription="Previous" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <!-- Image Carousel Container — GONE for ads without photos, so the
                         favorite/share row sits directly under the contact bar -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvImageContainer"
                        android:layout_width="match_parent"
                        android:layout_height="334dp"
                        android:layout_marginHorizontal="0dp"
                        android:layout_marginTop="0dp"
                        android:layoutDirection="ltr"
                        app:cardCornerRadius="0dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/ad_details_card_bg">

                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/vpImages"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layoutDirection="ltr" />

                        <ImageView
                            android:id="@+id/ivNoImagePlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_photo_placeholder"
                            android:visibility="gone"
                            android:contentDescription="@string/cd_image" />

                        <!-- Swipe Indicator (centered horizontally down inside the image) -->
                        <LinearLayout
                            android:id="@+id/llDotsIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_dots_indicator_pill"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:visibility="gone" />
                    </androidx.cardview.widget.CardView>

                    <!-- Favorite Button & Share Button (Figma Frame 43: 378x70dp, background #EEEEEE) -->
                    <RelativeLayout
                        android:id="@+id/rlFavoriteAndIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:layout_marginTop="0dp"
                        android:background="@color/frame_43_bg"
                        android:layoutDirection="ltr">

                        <LinearLayout
                            android:id="@+id/llLeftActions"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="21dp"
                            android:paddingEnd="0dp">

                            <!-- Favorite Button (Figma Group: 36x48dp, 5dp radius, left 21px, top 11px) -->
                            <FrameLayout
                                android:id="@+id/btnFavoriteDetail"
                                android:layout_width="36dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_detail_favorite_btn"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground">

                                <ImageView
                                    android:id="@+id/ivFavoriteDetail"
                                    android:layout_width="26dp"
                                    android:layout_height="36dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_favorite_bookmark_unselected"
                                    android:contentDescription="@string/cd_favorite" />
                            </FrameLayout>

                            <!-- Share Button (Figma Frame: 41x39dp, left 71px -> marginStart 14dp, top 15px) -->
                            <FrameLayout
                                android:id="@+id/btnShareDetail"
                                android:layout_width="41dp"
                                android:layout_height="39dp"
                                android:layout_marginStart="14dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackgroundBorderless">

                                <ImageView
                                    android:id="@+id/ivShareDetail"
                                    android:layout_width="41dp"
                                    android:layout_height="39dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_detail_share"
                                    android:contentDescription="@string/menu_share_app" />
                            </FrameLayout>
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Description Section (inside main card, below Frame 43) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_weight="1"
                        android:minHeight="302dp"
                        app:cardCornerRadius="0dp"
                        app:cardElevation="0dp"
                        app:cardMaxElevation="0dp"
                        app:cardBackgroundColor="@color/ad_details_card_bg"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/tvDescription"
                            style="@style/Find.Text.AdBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="302dp"
                            android:paddingHorizontal="16dp"
                            android:paddingTop="19dp"
                            android:paddingBottom="24dp"
                            android:textColor="@color/text_primary"
                            android:textAlignment="viewStart"
                            android:gravity="top|start" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Bottom Nav ── -->
    <include
        android:id="@+id/cvBottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
