<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/surface_primary"
    app:strokeColor="@android:color/black"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="locale">

        <!-- Top: image + info — image on RIGHT in LTR, LEFT in RTL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:orientation="horizontal"
            android:layoutDirection="locale">

            <!-- Info side — shown first in XML = LEFT in LTR, RIGHT in RTL -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layoutDirection="locale">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:layout_marginBottom="8dp" />

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                <!-- Price and Seller Name row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp"
                    android:layoutDirection="locale">

                    <!-- Seller avatar and name -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="start|center_vertical"
                        android:layoutDirection="locale">

                        <ImageView
                            android:id="@+id/ivSellerAvatar"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_avatar_placeholder"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:id="@+id/tvSellerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <!-- Price — icon LEFT of number, locale-aware -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layoutDirection="ltr">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_riyal"
                            android:contentDescription="@string/price"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/tvPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Location and Time row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layoutDirection="locale">

                    <!-- Time -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="start|center_vertical"
                        android:layoutDirection="locale">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_time"
                            android:contentDescription="@string/time" />

                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginStart="3dp" />
                    </LinearLayout>

                    <!-- Location -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layoutDirection="locale">

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_location"
                            android:contentDescription="@string/location" />

                        <TextView
                            android:id="@+id/tvLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginStart="3dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Image side — shown last in XML = RIGHT in LTR, LEFT in RTL -->
            <FrameLayout
                android:layout_width="130dp"
                android:layout_height="match_parent"
                android:clipToOutline="true"
                android:background="@drawable/bg_card_image_clip">

                <ImageView
                    android:id="@+id/ivImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_photo_placeholder" />

                <!-- Prev arrow — no background, thin chevron, auto-mirrors in RTL -->
                <ImageView
                    android:id="@+id/btnPrev"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_chevron_prev"
                    android:scaleType="fitCenter"
                    android:autoMirrored="true"
                    android:contentDescription="previous"
                    android:visibility="gone" />

                <!-- Next arrow — no background, thin chevron, auto-mirrors in RTL -->
                <ImageView
                    android:id="@+id/btnNext"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_chevron_next"
                    android:scaleType="fitCenter"
                    android:autoMirrored="true"
                    android:contentDescription="next"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <View 
            android:layout_width="match_parent" 
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Bottom actions: buttons LEFT, divider, toggle RIGHT (locale-aware) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp"
            android:paddingHorizontal="16dp"
            android:layoutDirection="ltr">

            <!-- Edit and Delete buttons — LEFT in LTR, RIGHT in RTL -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <Button
                    android:id="@+id/btnEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="100dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="@string/btn_edit"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/find_active_blue"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button" />

                <Button
                    android:id="@+id/btnDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="100dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_delete"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/error_red"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <!-- Vertical divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="60dp"
                android:background="@color/divider"
                android:layout_marginHorizontal="16dp" />

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <!-- Toggle visibility — RIGHT in LTR, LEFT in RTL -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@android:color/white"
                    app:trackTint="#E0E0E0" />

                <TextView
                    android:id="@+id/tvActiveLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:layout_marginStart="6dp"
                    android:text="@string/ad_hidden" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
