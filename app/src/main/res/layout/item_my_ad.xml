<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:clipToOutline="true"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/black"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="locale">

        <!-- Top Content Section (wrap_content with minHeight 130dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="130dp"
            android:orientation="horizontal"
            android:layoutDirection="locale">

            <!-- Right Details Area (Column) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="130dp"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="6dp"
                android:layoutDirection="locale">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:lines="4"
                    android:minLines="4"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:gravity="top|start"
                    android:textAlignment="viewStart"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="0.80"
                    android:lineSpacingExtra="-2dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Row 1: Location -->
                <LinearLayout
                    android:id="@+id/llRowLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                    app:layout_constraintBottom_toTopOf="@+id/llRowBottom"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintVertical_bias="1.0">

                    <!-- Location Group -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivLocationIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_map_pin"
                            app:tint="@color/text_primary"
                            android:layout_marginEnd="4dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvLocation"
                            style="@style/Find.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="@color/text_primary"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Time (start) and Price (end) down with text -->
                <LinearLayout
                    android:id="@+id/llRowBottom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@+id/llRowLocation"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Time Group -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivTimeIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_time"
                            app:tint="@color/text_primary"
                            android:layout_marginEnd="4dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvTime"
                            style="@style/Find.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="@color/text_primary"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <!-- Spacer -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <!-- Price Group (down with text, SAR icon on other side) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivRiyalSymbol"
                            android:layout_width="18dp"
                            android:layout_height="19dp"
                            android:src="@drawable/ic_currency_sar"
                            app:tint="@color/text_primary"
                            android:layout_marginEnd="3dp" />

                        <TextView
                            android:id="@+id/tvPrice"
                            style="@style/Find.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Hidden seller views (removed from outside card) -->
                <ImageView
                    android:id="@+id/ivSellerAvatar"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSellerName"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Left Image Viewport Box (renders on Left in RTL) -->
            <FrameLayout
                android:id="@+id/flCardImage"
                android:layout_width="130dp"
                android:layout_height="match_parent">

                <!-- Swipeable gallery (same behaviour as the ad details and home feed) -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpCardImages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layoutDirection="ltr"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_photo_placeholder"
                    android:background="@color/placeholder_bg" />

                <!-- Dots indicator, over the image (as on the home card and ad details) -->
                <LinearLayout
                    android:id="@+id/llCardDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_dots_indicator_pill"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <View 
            android:layout_width="match_parent" 
            android:layout_height="1dp"
            android:background="@color/card_divider" />

        <!-- Bottom Panel (60.dp height) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="locale">

            <!-- Right Interactive Region: Visibility toggles centered -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:layoutDirection="locale">

                <TextView
                    android:id="@+id/tvActiveLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:paddingVertical="4dp"
                    android:text="@string/ad_hidden" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layoutDirection="ltr"
                    app:thumbTint="@android:color/white"
                    app:trackTint="@color/switch_inactive_track" />
            </LinearLayout>

            <!-- Central Vertical line divider axis -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="12dp"
                android:background="@color/card_divider" />

            <!-- Left Interactive Region: Stacked buttons centered -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    android:layout_width="87dp"
                    android:layout_height="24dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:gravity="center"
                    android:text="@string/btn_edit"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/add_ad_header_bg"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    android:layout_width="87dp"
                    android:layout_height="24dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:text="@string/action_delete"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/error_red"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
