<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/black"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="locale">

        <!-- Top Content Section (Row, 130.dp height) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:orientation="horizontal"
            android:layoutDirection="locale">

            <!-- Right Details Area (Column) — shown first in XML = LEFT in LTR, RIGHT in RTL -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layoutDirection="locale">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:layout_marginBottom="8dp" />

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                <!-- Price and Username baseline row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp"
                    android:layoutDirection="locale">

                    <!-- Seller avatar and name -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="start|center_vertical"
                        android:layoutDirection="locale">

                        <ImageView
                            android:id="@+id/ivSellerAvatar"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_avatar_placeholder"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:id="@+id/tvSellerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="@color/black"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- Price Group -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivRiyalSymbol"
                            android:layout_width="10dp"
                            android:layout_height="11dp"
                            android:src="@drawable/ic_currency_sar"
                            app:tint="@color/text_primary"
                            android:layout_marginEnd="3dp" />

                        <TextView
                            android:id="@+id/tvPrice"
                            style="@style/Find.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Location and Time row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layoutDirection="locale">

                    <!-- Location -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="start|center_vertical"
                        android:layoutDirection="locale">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_map_pin"
                            app:tint="@color/text_primary"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@string/location" />

                        <TextView
                            android:id="@+id/tvLocation"
                            style="@style/Find.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- Time -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layoutDirection="locale">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_time"
                            app:tint="@color/text_primary"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@string/time" />

                        <TextView
                            android:id="@+id/tvTime"
                            style="@style/Find.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Left Image Viewport Box (renders on Left in RTL) -->
            <FrameLayout
                android:id="@+id/flCardImage"
                android:layout_width="130dp"
                android:layout_height="match_parent">

                <!-- Swipeable gallery (same behaviour as the ad details and home feed) -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpCardImages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layoutDirection="ltr"
                    android:visibility="gone" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_photo_placeholder"
                    android:background="@color/image_placeholder_bg"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Card.ImageSide" />

                <!-- Dots indicator, over the image (as on the home card and ad details) -->
                <LinearLayout
                    android:id="@+id/llCardDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_dots_indicator_pill"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <View 
            android:layout_width="match_parent" 
            android:layout_height="1dp"
            android:background="@color/card_divider" />

        <!-- Bottom Panel (60.dp height) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="locale">

            <!-- Right Interactive Region: Visibility toggles centered -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:layoutDirection="locale">

                <TextView
                    android:id="@+id/tvActiveLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:paddingVertical="4dp"
                    android:text="@string/ad_hidden" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layoutDirection="ltr"
                    app:thumbTint="@android:color/white"
                    app:trackTint="@color/switch_inactive_track" />
            </LinearLayout>

            <!-- Central Vertical line divider axis -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="12dp"
                android:background="@color/card_divider" />

            <!-- Left Interactive Region: Stacked buttons centered -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    android:layout_width="87dp"
                    android:layout_height="24dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:gravity="center"
                    android:text="@string/btn_edit"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/add_ad_header_bg"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    android:layout_width="87dp"
                    android:layout_height="24dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:text="@string/action_delete"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/error_red"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
