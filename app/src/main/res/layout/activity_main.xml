<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/category_grid_bg"
    android:layoutDirection="locale">

    <!-- ── Top App Bar (Sticky) ── -->
    <include
        android:id="@+id/llAppBar"
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Search bar (pinned above the filter lists) ── -->
    <FrameLayout
        android:id="@+id/flSearchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_bg"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/llAppBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/llSearchContainer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_bar"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layoutDirection="locale"
            android:paddingHorizontal="12dp">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:layoutDirection="locale"
                android:gravity="start|center_vertical"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:includeFontPadding="false"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:textColorHint="@color/search_hint_text" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_search"
                app:tint="@color/search_icon_tint" />
        </LinearLayout>
    </FrameLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/homeScrollCoordinator"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/category_grid_bg"
        app:layout_constraintTop_toBottomOf="@id/flSearchBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/header_bg"
            app:elevation="0dp">

        <!-- Tab / filter rows: collapse on scroll down, re-enter on any scroll up -->
        <LinearLayout
            android:id="@+id/llHomeFilterStrips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll|enterAlways|snap">

        <!-- Top category tabs -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTopTabs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_tab_height"
            android:background="@drawable/bg_tab_row"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Sub-category tabs -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSubTabs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_tab_height"
            android:background="@drawable/bg_tab_row"
            android:visibility="gone"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Extra (filter_option) tabs -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExtraTabs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_tab_height"
            android:background="@drawable/bg_tab_row"
            android:visibility="gone"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Filter bar: chips row (الكل / عرض / طلب) — shown only at listings level -->
        <LinearLayout
            android:id="@+id/llFilterBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_tab_height"
            android:orientation="horizontal"
            android:gravity="start"
            android:background="@drawable/bg_tab_row"
            android:visibility="gone">

            <!-- الكل Tab -->
            <LinearLayout
                android:id="@+id/llChipAll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <View
                    android:layout_width="0dp"
                    android:layout_height="3dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.example.myapplication.widgets.StrokeTextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/filter_all"
                    android:textSize="16sp"
                    android:textColor="@color/tab_label_active" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <View
                    android:id="@+id/underlineAll"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginBottom="@dimen/tab_row_strip"
                    android:background="@drawable/bg_tab_underline_active" />
            </LinearLayout>

            <!-- العرض Tab -->
            <LinearLayout
                android:id="@+id/llChipOffer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <View
                    android:layout_width="0dp"
                    android:layout_height="3dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.example.myapplication.widgets.StrokeTextView
                    android:id="@+id/chipOffer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/filter_offer"
                    android:textSize="16sp"
                    android:textColor="@color/tab_label_inactive" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <View
                    android:id="@+id/underlineOffer"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginBottom="@dimen/tab_row_strip"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <!-- الطلب Tab -->
            <LinearLayout
                android:id="@+id/llChipRequest"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <View
                    android:layout_width="0dp"
                    android:layout_height="3dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.example.myapplication.widgets.StrokeTextView
                    android:id="@+id/chipRequest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/filter_request"
                    android:textSize="16sp"
                    android:textColor="@color/tab_label_inactive" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <View
                    android:id="@+id/underlineRequest"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginBottom="@dimen/tab_row_strip"
                    android:background="@android:color/transparent" />
            </LinearLayout>

        </LinearLayout>

        <!-- Region row — shown after chips row is visible -->
        <HorizontalScrollView
            android:id="@+id/llRegionRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_tab_height"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:fillViewport="true"
            android:background="@drawable/bg_tab_row"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="10dp"
                android:paddingTop="0dp"
                android:paddingBottom="5dp">

                <LinearLayout
                    android:id="@+id/spinnerRegion"
                    android:layout_width="182dp"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_spinner_pill"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvRegionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/all_regions"
                        android:textSize="16sp"
                        android:textColor="@color/tab_row_text" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/ivRegionChevron"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/tab_row_text" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/spinnerCity"
                    android:layout_width="182dp"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_spinner_pill"
                    android:paddingHorizontal="14dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvCityLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/all_cities"
                        android:textSize="16sp"
                        android:textColor="@color/tab_row_text" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/ivCityChevron"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/tab_row_text" />

                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Boot shimmer -->
        <LinearLayout
            android:id="@+id/bootShimmer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_tab_height"
            android:background="@color/tab_bar_loading_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <View android:layout_width="80dp" android:layout_height="32dp"
                android:layout_marginEnd="8dp" android:background="@drawable/bg_category_shimmer" />
            <View android:layout_width="100dp" android:layout_height="32dp"
                android:layout_marginEnd="8dp" android:background="@drawable/bg_category_shimmer" />
            <View android:layout_width="120dp" android:layout_height="32dp"
                android:layout_marginEnd="8dp" android:background="@drawable/bg_category_shimmer" />
            <View android:layout_width="70dp" android:layout_height="32dp"
                android:background="@drawable/bg_category_shimmer" />
        </LinearLayout>

        </LinearLayout>

        </com.google.android.material.appbar.AppBarLayout>

    <!-- ── Content area ──
         Each list is its own full-height RecyclerView that scrolls natively and
         recycles its rows (no NestedScrollView wrapping wrap_content lists, which
         inflated every row up-front and caused jank). Their nested-scroll events
         reach the CoordinatorLayout through this FrameLayout, so the filter strips
         above collapse / re-enter in sync with the list. Bottom padding that clears
         the floating bottom nav is applied at runtime (it includes the nav-bar inset). -->
        <FrameLayout
            android:id="@+id/flContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/category_grid_bg"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <!-- Case A-1: Top-level category grid (home, no selection) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategoryGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/category_grid_bg"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:paddingTop="8dp"
                android:paddingBottom="104dp"
                android:paddingHorizontal="8dp"
                android:visibility="gone" />

            <!-- Case A-2: Sub-category grid (after tapping a top-level category on home) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSubCategoryGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/category_grid_bg"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:paddingTop="8dp"
                android:paddingBottom="104dp"
                android:paddingHorizontal="8dp"
                android:visibility="gone" />

            <!-- Home grid loading spinner -->
            <ProgressBar
                android:id="@+id/pbHomeGrid"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/find_primary"
                android:visibility="gone" />

            <!-- Case B: Listings list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvListings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:paddingTop="8dp"
                android:paddingBottom="110dp"
                android:visibility="gone" />

            <!-- Listings shimmer (first page loading) -->
            <LinearLayout
                android:id="@+id/llListingsShimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:visibility="gone">

                <include layout="@layout/item_listing_shimmer" />
                <include layout="@layout/item_listing_shimmer" />
                <include layout="@layout/item_listing_shimmer" />
                <include layout="@layout/item_listing_shimmer" />
            </LinearLayout>

            <!-- Empty state with Add Ad button -->
            <LinearLayout
                android:id="@+id/llEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="300dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:paddingBottom="30dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEmptyNoAds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_no_ads"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center" />

                <LinearLayout
                    android:id="@+id/btnAddAdEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/add"
                        android:scaleType="fitCenter"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/empty_add_ad"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- ── Bottom Nav ── -->
    <include
        android:id="@+id/cvBottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/btnBackToParent"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_menu_circle"
        android:src="@drawable/ic_arrow_up"
        android:scaleType="centerInside"
        android:elevation="4dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/cvBottomNav"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
