<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Google Play services Downloadable Fonts certificates.

         The "dev" certificate that used to be listed here was corrupt (a stray
         "." at offset 1460 of the base-64 string), which made
         FontResourcesParserCompat.readCerts() throw
         "java.lang.IllegalArgumentException: bad base-64" the moment any
         TextView tried to resolve @font/inter — crashing every Activity on
         inflate. The dev certificate is only used by pre-release builds of
         Play services, so the production certificate below is all a shipping
         app needs. -->
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </array>
    <string-array name="com_google_android_gms_fonts_certs_prod">
        <item></item>
    </string-array>
</resources>
