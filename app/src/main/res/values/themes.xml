<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/find_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/stroke_field</item>
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:colorBackground">@color/bg_screen</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- NOTE: do NOT point this at @font/inter or @font/cairo until Inter is
             bundled as real .ttf files in res/font/.

             Both of those are *downloadable* fonts served by Google Play
             services, and both resolve their signatures through
             @array/com_google_android_gms_fonts_certs in res/values/font_certs.xml.
             That certs file is not the real Google one — its base-64 is
             fabricated (the dev cert had a stray "." at offset 1460; the prod
             cert ends in the repeating filler "0Ae7X0ZeXGy0+..." and is 965
             chars, not a multiple of 4). Android's Base64 decoder rejects it
             with "bad base-64", which made FontResourcesParserCompat blow up
             inside every TextView's constructor — so setting the font on the
             theme crashed every single Activity on inflate.

             iOS bundles Inter-Regular/Medium/SemiBold/Bold .ttf in the app
             (see App/AppFont.swift). Android should do the same: drop the four
             .ttf files into res/font/, replace inter.xml with a static
             font-family listing the four weights, delete font_certs.xml, then
             re-add the two lines below. -->
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />

    <!-- Shape appearance overlay for cards with top-rounded corners only -->
    <style name="ShapeAppearance.Card.TopRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">5dp</item>
        <item name="cornerSizeTopRight">5dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Shape appearance overlay for card image: rounded corners on the right side in LTR -->
    <style name="ShapeAppearance.Card.ImageSide" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeTopRight">10dp</item>
        <item name="cornerSizeBottomRight">10dp</item>
    </style>

    <!-- Shape appearance overlay for card image: all corners rounded 8dp -->
    <style name="ShapeAppearance.Card.AllRounded8" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
</resources>