<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft shadow (alpha 1%) -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#03000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Medium shadow layer (alpha 2%) -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#05000000" />
            <corners android:radius="11dp" />
        </shape>
    </item>

    <!-- Inner darker shadow layer (alpha 3%) -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#08000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Core shadow layer (alpha 5%) -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#0D000000" />
            <corners android:radius="9dp" />
        </shape>
    </item>

    <!-- Main White background box with border -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#E0E0E0" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
