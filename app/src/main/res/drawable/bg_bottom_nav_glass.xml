<?xml version="1.0" encoding="utf-8"?>
<!-- Light design bottom nav: frosted white pill, 25% black rim, thin white inner highlight. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/nav_glass_top"
                android:endColor="@color/nav_glass_bottom" />
            <stroke
                android:width="1dp"
                android:color="@color/nav_glass_rim" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/nav_glass_highlight" />
            <corners android:radius="29dp" />
        </shape>
    </item>
</layer-list>
