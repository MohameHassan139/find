<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom border/divider color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tab_bar_divider" />
        </shape>
    </item>
    <!-- Main background of the tab row, leaving 3dp space at the bottom for the divider -->
    <item android:bottom="@dimen/tab_row_strip">
        <shape android:shape="rectangle">
            <solid android:color="@color/tab_bar_bg" />
        </shape>
    </item>
</layer-list>
