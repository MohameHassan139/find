<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked & Disabled -->
    <item android:state_checked="true" android:state_enabled="false" android:drawable="@drawable/cb_checked_disabled" />
    <!-- Checked & Enabled -->
    <item android:state_checked="true" android:state_enabled="true" android:drawable="@drawable/cb_checked_enabled" />
    <!-- Unchecked & Disabled -->
    <item android:state_checked="false" android:state_enabled="false" android:drawable="@drawable/cb_unchecked_disabled" />
    <!-- Unchecked & Enabled -->
    <item android:state_checked="false" android:state_enabled="true" android:drawable="@drawable/cb_unchecked_enabled" />
</selector>
