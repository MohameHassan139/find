<?xml version="1.0" encoding="utf-8"?>
<!-- Clips image corners to match card radius on the outer edge.
     Card's own clipToOutline handles the actual visual clipping. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/image_placeholder_bg" />
    <corners android:radius="14dp" />
</shape>
